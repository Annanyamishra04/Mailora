# AI Mail Studio — environment variables
#
# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Supabase (authentication + database)
# ---------------------------------------------------------------------------

# Required. Your Supabase project URL and anon (public) key, from
# Project Settings → API in the Supabase dashboard. These are prefixed
# NEXT_PUBLIC_ because the browser needs them to talk to Supabase Auth
# directly — the anon key is safe to expose; it only grants what your
# Row Level Security policies allow.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL — leave this unset. No route in the app uses it (see
# lib/supabase/admin.ts, which nothing imports), so putting it in your
# deployment only adds risk: if it ever leaked it would bypass Row Level
# Security for every user. Set it only if you later add a privileged
# server-side job. NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI provider (unchanged from earlier phases)
# ---------------------------------------------------------------------------
#
# All variables below are server-only. None are prefixed NEXT_PUBLIC_,
# so none are ever sent to the browser.

# Required. API key for Google's Gemini API, used to generate and rewrite
# emails. Get a free development key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Recommended: set this explicitly. Google retires Gemini models on a rolling
# schedule — "gemini-2.0-flash" (the default in earlier phases) was SHUT DOWN
# on 2026-06-01 and now fails every request. If unset, the app falls back to
# "gemini-3.5-flash". Check https://ai.google.dev/gemini-api/docs/models and
# https://ai.google.dev/gemini-api/docs/deprecations for what is current.
GEMINI_MODEL=gemini-3.5-flash

# Optional. Which AI provider adapter to use. Currently only "gemini" is
# implemented. Defaults to "gemini" if unset.
AI_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Rate limiting (Phase 6) — all optional, all server-only
# ---------------------------------------------------------------------------
#
# Best-effort, in-memory, per server instance — NOT a global limit on
# serverless platforms. See "Rate limiting" in the README. Invalid values
# fall back to the defaults shown (with a warning in the server log).

# AI requests allowed per signed-in user per window (every /api/ai/* call).
# AI_RATE_LIMIT_MAX=15
# AI_RATE_LIMIT_WINDOW_MS=60000

# Email/template create/update/delete requests per signed-in user per window.
# API_RATE_LIMIT_MAX=120
# API_RATE_LIMIT_WINDOW_MS=60000

# Requests per client IP per window across all /api/* routes (checked before
# any database or auth call, to keep anonymous floods cheap).
# API_IP_RATE_LIMIT_MAX=300
